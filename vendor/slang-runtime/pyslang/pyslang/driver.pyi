"""Compilation driver"""

from collections.abc import Sequence
import os
import pathlib

import pyslang
import pyslang.analysis
import pyslang.ast
import pyslang.syntax


class CommandLineOptions:
    def __init__(self) -> None: ...

    @property
    def supportsComments(self) -> bool: ...

    @supportsComments.setter
    def supportsComments(self, arg: bool, /) -> None: ...

    @property
    def ignoreProgramName(self) -> bool: ...

    @ignoreProgramName.setter
    def ignoreProgramName(self, arg: bool, /) -> None: ...

    @property
    def expandEnvVars(self) -> bool: ...

    @expandEnvVars.setter
    def expandEnvVars(self, arg: bool, /) -> None: ...

    @property
    def ignoreDuplicates(self) -> bool: ...

    @ignoreDuplicates.setter
    def ignoreDuplicates(self, arg: bool, /) -> None: ...

class Driver:
    def __init__(self) -> None: ...

    class CommandFileMetadata:
        def __init__(self) -> None: ...

        @property
        def defines(self) -> list[str]: ...

        @defines.setter
        def defines(self, arg: Sequence[str], /) -> None: ...

    @property
    def sourceManager(self) -> pyslang.SourceManager: ...

    @property
    def diagEngine(self) -> pyslang.DiagnosticEngine: ...

    @property
    def textDiagClient(self) -> pyslang.TextDiagnosticClient: ...

    @property
    def sourceLoader(self) -> SourceLoader: ...

    @property
    def syntaxTrees(self) -> list[pyslang.syntax.SyntaxTree]: ...

    @property
    def languageVersion(self) -> pyslang.LanguageVersion: ...

    @languageVersion.setter
    def languageVersion(self, arg: pyslang.LanguageVersion, /) -> None: ...

    @property
    def analysisOptions(self) -> pyslang.analysis.AnalysisOptions: ...

    @property
    def commandFileMetadata(self) -> dict[pathlib.Path, Driver.CommandFileMetadata]: ...

    def addStandardArgs(self) -> None: ...

    def parseCommandLine(self, arg: str, parseOptions: CommandLineOptions = ...) -> bool: ...

    def processCommandFiles(self, fileName: str, makeRelative: bool, separateUnit: bool) -> bool: ...

    def processOptions(self, checkFiles: bool = True) -> bool: ...

    def runPreprocessor(self, flags: pyslang.PreprocessOutputFlags) -> bool: ...

    def reportMacros(self, groupByFile: bool = False) -> None: ...

    def optionallyWriteDepFiles(self) -> None: ...

    def parseAllSources(self, bufferChangeCB: object | None = None) -> bool: ...

    def createOptionBag(self) -> pyslang.Bag: ...

    def createCompilation(self) -> pyslang.ast.Compilation: ...

    def reportParseDiags(self) -> bool: ...

    def reportCompilation(self, compilation: pyslang.ast.Compilation, quiet: bool) -> None: ...

    def runAnalysis(self, compilation: pyslang.ast.Compilation) -> "slang::analysis::AnalysisManager": ...

    def reportDiagnostics(self, quiet: bool) -> bool: ...

    def runFullCompilation(self, quiet: bool = False) -> bool: ...

    def setTerminalColorsEnabled(self, enable: bool) -> None: ...

class SourceOptions:
    def __init__(self) -> None: ...

    @property
    def numThreads(self) -> int | None: ...

    @numThreads.setter
    def numThreads(self, arg: int | None, /) -> None: ...

    @property
    def singleUnit(self) -> bool: ...

    @singleUnit.setter
    def singleUnit(self, arg: bool, /) -> None: ...

    @property
    def onlyLint(self) -> bool: ...

    @onlyLint.setter
    def onlyLint(self, arg: bool, /) -> None: ...

    @property
    def librariesInheritMacros(self) -> bool: ...

    @librariesInheritMacros.setter
    def librariesInheritMacros(self, arg: bool, /) -> None: ...

class SourceLoader:
    def __init__(self, sourceManager: pyslang.SourceManager) -> None: ...

    def addFiles(self, pattern: str) -> None: ...

    def addLibraryFiles(self, libraryName: str, pattern: str) -> None: ...

    def addSearchDirectories(self, pattern: str) -> None: ...

    def addSearchExtension(self, extension: str) -> None: ...

    def addLibraryMaps(self, pattern: str, basePath: str | os.PathLike, optionBag: pyslang.Bag) -> None: ...

    def addSeparateUnit(self, filePatterns: span[str], includePaths: Sequence[str], defines: Sequence[str], libraryName: str, warningOptions: Sequence[str]) -> None: ...

    def loadSources(self) -> list[pyslang.SourceBuffer]: ...

    def loadAndParseSources(self, optionBag: pyslang.Bag) -> list[pyslang.syntax.SyntaxTree]: ...

    @property
    def hasFiles(self) -> bool: ...

    @property
    def libraryMaps(self) -> list[pyslang.syntax.SyntaxTree]: ...

    @property
    def errors(self) -> span[str]: ...
